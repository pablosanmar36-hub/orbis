# Copia este archivo como .env (no se sube a git) y rellena los valores.
# En Vercel: Settings → Environment Variables.

# Cadena de conexión de Neon (Dashboard → Connection string)
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/neondb?sslmode=require

# Clave para firmar los JWT: mínimo 32 caracteres aleatorios.
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Notificaciones push. Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
# Secreto del aviso diario (Vercel Cron lo envía solo). 32+ caracteres aleatorios.
CRON_SECRET=
